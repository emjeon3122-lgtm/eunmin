# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 에는 비밀값이 들어가므로 메일·메신저·저장소에 올리지 않는다.

# 대시보드 주소(HTTPS). SSO 사용 시 필수 — Entra ID 앱 등록의 리디렉션 URI 는 이 주소 + /auth/callback
PUBLIC_URL=https://dashboard.example.local
# NAS 에서 열 포트
HOST_PORT=8080

# 처음 설정용 관리자(쉼표로 여러 명). 그 밖의 사람은 입력용 엑셀 '권한' 시트로 관리한다.
ADMIN_EMAILS=admin@example.com

# 로그인 방식: local(SSO 연결 전 임시 관리자 로그인) 또는 oidc(회사 계정 SSO)
AUTH_MODE=local
# local: node tools/hash-password.js 로 만든 값 (docker compose run --rm dashboard node tools/hash-password.js)
LOCAL_ADMIN_PASSWORD_HASH=

# oidc (Microsoft Entra ID): IT 관리자가 앱 등록 후 알려주는 값
# OIDC_ISSUER=https://login.microsoftonline.com/<테넌트ID>/v2.0
# OIDC_TENANT_ID=<테넌트ID>
# OIDC_CLIENT_ID=<애플리케이션(클라이언트) ID>
# OIDC_CLIENT_SECRET=<클라이언트 암호>

# HTTPS 뒤(NAS 역방향 프록시)에서 실행하면 true 유지. 사내 테스트로 http 로만 열 때만 false.
COOKIE_SECURE=true
# 역방향 프록시가 X-Forwarded-For 를 붙여 줄 때 true
TRUST_PROXY=true
SESSION_HOURS=8
MAX_UPLOAD_MB=80
