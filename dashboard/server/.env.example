# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 에는 비밀값이 들어가므로 메일·메신저·저장소에 올리지 않는다.
# (값 대신 파일 경로를 쓰려면 변수 이름 뒤에 _FILE 을 붙인다. 예: OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc)

# ---- 주소·포트 ----
# 사용자가 접속하는 주소(DSM 역방향 프록시 https). Entra 리디렉션 URI = 이 주소 + /auth/callback
PUBLIC_URL=https://192.168.100.25:7021
# 앱이 여는 포트(http). 역방향 프록시가 여기로 넘겨준다. host 네트워크이므로 127.0.0.1 로만 연다.
PORT=7020
HOST=127.0.0.1
# 역방향 프록시가 붙여 주는 X-Forwarded-For 로 접속자 IP 를 기록한다
TRUST_PROXY=true
# HTTPS(역방향 프록시) 뒤에서 쓰므로 true 유지
COOKIE_SECURE=true

# ---- 세션 ----
# 세션 암호화 키: 32자 이상 임의 문자열 (예: openssl rand -base64 48). 바꾸면 모든 사용자가 다시 로그인한다.
SESSION_SECRET=
SESSION_HOURS=8

# ---- 관리자 ----
# 처음 설정용 관리자 이메일(쉼표로 여러 명). 이 밖의 사람은 입력용 엑셀 '권한' 시트로 관리한다.
ADMIN_EMAILS=

# ---- 로그인 방식 ----
# local: SSO 연결 전 임시 관리자 로그인 / oidc: 회사 계정 SSO(Microsoft Entra ID)
AUTH_MODE=oidc
# local 일 때만: docker compose run --rm dashboard node tools/hash-password.js 로 만든 값
LOCAL_ADMIN_PASSWORD_HASH=

# ---- Microsoft Entra ID (AUTH_MODE=oidc) ----
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 로그인을 허용할 이메일 도메인(쉼표로 여러 개)
ALLOWED_EMAIL_DOMAINS=bdo.kr
# 이 Entra 앱 역할을 받은 사람은 관리자(전체 조회 + 자료 올리기·확정 관리)
OIDC_ADMIN_ROLE=Admin
# (선택) 발급자 주소를 직접 지정할 때만. 비우면 OIDC_TENANT_ID 로 자동 구성
# OIDC_ISSUER=

# ---- 시간대 ----
# (선택) 자동 확정일·자동 백업 시각을 판단하는 시간대. 기본값 Asia/Seoul 이 이미지에 들어 있어 보통 적지 않는다
# TZ=Asia/Seoul

# ---- 자동 백업 ----
# 매일 이 시각(시) 이후 하루 한 번 백업 파일을 만든다. 폴더를 비우면 /data/backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
# BACKUP_DIR=/data/backups

# ---- 업데이트 ----
# (선택) 예전 버전에서 확정한 달의 기장 수기분이 입력용 기장추가와 다를 때만 쓴다(UPDATE.md 참고).
#   input  = 2026.10.06-6 이하에서 업데이트,  stored = 2026.10.06-7·-8 에서 업데이트.  비우면 바꾸지 않고 알리기만 한다.
# LEGACY_LOCK_GIJANG=

MAX_UPLOAD_MB=80
