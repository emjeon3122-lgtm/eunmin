# ─────────────────────────────────────────────────────────────────────────────
# 경조사 화환 앱 운영 설정 — 이 파일을 .env로 복사해서 값을 채웁니다.
#   cp .env.example .env
# .env에는 비밀값이 들어가므로 외부로 공유하거나 git에 올리지 마세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── NAS 연결 ────────────────────────────────────────────────────────────────
# 앱 전용 공유폴더 안의 데이터 경로. DB(db/)와 업로드 파일(uploads/)이 여기에 생깁니다.
# 이 폴더만 백업하면 앱 데이터 전체가 보존됩니다.
DATA_DIR=/volume1/wreath-app/data

# 컨테이너를 실행할 NAS 전용 계정의 UID/GID (SSH에서 `id 계정명`으로 확인).
# 이 계정은 DATA_DIR에만 읽기/쓰기 권한이 있으면 됩니다.
APP_UID=
APP_GID=

# Cloudflare Zero Trust > Networks > Tunnels 에서 만든 Tunnel의 토큰.
# Tunnel의 Public hostname 연결 대상(Service)은 http://web:3000 으로 지정합니다.
CLOUDFLARE_TUNNEL_TOKEN=

# ── 앱 기본 ─────────────────────────────────────────────────────────────────
# 실제 접속 주소(Tunnel에 연결한 도메인). 알림톡 버튼 링크에 그대로 쓰입니다. https 필수.
APP_BASE_URL=https://wreath.example.com

# 로그인 토큰 서명 키. 32자 이상 임의 문자열 (예: `openssl rand -hex 32` 결과).
# 값이 기본값이거나 짧으면 서버가 시작되지 않습니다.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── 로그인 ──────────────────────────────────────────────────────────────────
# mock: 개발용 사번 로그인(아래 ALLOW_DEV_LOGIN=true일 때만) / oidc: Microsoft 365 로그인
# oidc 설정 방법은 README "Microsoft 365 로그인 켜기" 참고(OIDC_* 값은 전산 담당자가 입력).
AUTH_MODE=mock
# 사번만으로 로그인하는 개발용 로그인. 운영에서는 기본 차단됩니다.
# 시험 운영 중 잠깐 켜야 한다면 true로 바꾸되, 인터넷에서 누구나 사번으로 들어올 수
# 있으므로 시험이 끝나면 반드시 지우세요.
ALLOW_DEV_LOGIN=false
# 예: https://login.microsoftonline.com/<테넌트 ID>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# https://<도메인>/api/auth/oidc/callback (Entra 앱 등록의 리디렉션 URI와 똑같이)
OIDC_REDIRECT_URI=

# ── 알림톡 (Solapi) ─────────────────────────────────────────────────────────
# mock: 실제 발송 없이 기록만 남김 / kakao: Solapi로 실제 발송
VENDOR_ADAPTER=mock
KAKAO_CPAAS_API_KEY=
KAKAO_CPAAS_API_SECRET=
KAKAO_CPAAS_SENDER_KEY=
KAKAO_CPAAS_SENDER_PHONE=
KAKAO_CPAAS_API_BASE_URL=https://api.solapi.com
KAKAO_CPAAS_TEMPLATE_ID=
# 발송 결과(메시지 리포트) 웹훅 주소의 비밀값 — 32자 이상 임의 문자열(`openssl rand -hex 32`).
# 솔라피 콘솔 웹훅에 https://<도메인>/api/webhooks/solapi/<이 값> 을 등록합니다.
# 비워두면 콜백을 받지 않습니다(발송 자체는 정상 동작, 결과 확인만 안 됨).
KAKAO_WEBHOOK_SECRET=

# ── 청첩장 AI 자동 채우기 (기본 꺼짐) ─────────────────────────────────────────
# claude로 켜면 서버가 직원이 입력한 청첩장 URL에 직접 접속합니다. 내부망 접속 차단
# 처리가 들어가기 전까지는 mock으로 두세요.
INVITATION_PARSER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
