# Database — SQLite 파일 하나로 동작한다(별도 DB 서버/계정 불필요).
# 경로는 prisma/schema.prisma 기준이라 실제 파일은 apps/api/prisma/dev.db 에 생긴다.
DATABASE_URL="file:./dev.db"

# App
PORT=4000
APP_BASE_URL="http://localhost:3000"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Auth mode: "mock" enables POST /api/auth/dev-login for local development
# (no real IdP configured yet — see docs/01-architecture-and-db.md section 3-1).
# Switch to "oidc" once an IdP is chosen and fill in the OIDC_* vars below.
AUTH_MODE="mock"
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""

# Vendor adapter: "mock" logs the message instead of calling a real CPaaS.
# CPaaS 대행사는 Solapi(카카오 알림톡)로 확정 — 계약/실제 API 키가 준비되면
# "kakao"로 전환한다 (src/vendor/solapi-alimtalk.adapter.ts).
VENDOR_ADAPTER="mock"
KAKAO_CPAAS_API_KEY=""
KAKAO_CPAAS_SENDER_KEY=""       # Solapi 발신프로필 키(pfId)
KAKAO_CPAAS_API_BASE_URL=""
KAKAO_CPAAS_TEMPLATE_ID=""      # 사전 심사된 알림톡 템플릿 ID
KAKAO_WEBHOOK_SECRET="change-me"

# File storage: local disk under ./uploads for development.
# Swap for an S3-compatible adapter before production (see docs/04 section 8-3).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
